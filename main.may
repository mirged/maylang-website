// maysite — the Maylang website generator.
//
// `maysite build` renders the site into build/site/.
// `maysite check` builds, then verifies the generated output.
//
// The generator intentionally uses only the Maylang standard library and the
// compiler's own file, JSON, string and process APIs.
import "src/build.may" as build;
import "src/serve.may" as serve;
fun usage() -> Nil {
    print("maysite — the Maylang website generator\n\n  maysite build          Render build/site/\n  maysite check          Render, then verify links and page structure\n  maysite serve [PORT]   Build, then serve build/site on 127.0.0.1 (default 8000)\n  maysite version        Print the generator version\n\nEnvironment:\n  MAYLANG_SRC            Path to a Maylang checkout (default: ../maylang)\n  MAYC                   Compiler used for sample verification (default: mayc)\n");
    return;
}
let argv: List<Str> = args();
let command: Str = if (len(argv) > 1) {
    argv[1]
} else {
    "build"
};
let root: Str = if (len(argv) > 2 and argv[2] != "--") {
    argv[2]
} else {
    "."
};
if (command == "help" or command == "--help" or command == "-h") {
    usage();
    exit(0);
}
if (command == "version" or command == "--version") {
    print("maysite 0.1.0");
    exit(0);
}
if (command == "build") {
    exit(build.run(root, false));
}
if (command == "check") {
    exit(build.run(root, true));
}
if (command == "serve") {
    let port: Int = if (len(argv) > 2) {
        int(argv[2])
    } else {
        8000
    };
    print("building the site first…");
    let status: Int = build.run(".", false);
    if (status != 0) {
        exit(status);
    }
    let served: Int = may {
        serve.run(".", port)
    } otherwise {
        print("maysite: cannot serve on 127.0.0.1:" + str(port) + ": " + str(err.message));
        print("hint: another process may already be using that port; try ./maysite serve 8001");
        1
    };
    exit(served);
}
if (command == "page") {
    if (len(argv) < 5) {
        print("maysite: page needs a pages file and an index");
        exit(2);
    }
    exit(build.render_one(argv[2], argv[3], int(argv[4])));
}
usage();
exit(2);
