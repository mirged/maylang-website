import "../src/config.may" as config;
import "../src/html.may" as html;
import "../src/jsonlite.may" as jsonlite;
import "test" as test;
let parsed: Any = config.front_matter("---\ntitle: Test\norder: 3\n---\n\n# Body\n");
test.assert_equal(parsed.meta.title, "Test", "front matter title");
test.assert_equal(parsed.meta.order, "3", "front matter order");
test.assert_contains(parsed.body, "# Body", "front matter body");
let no_header: Any = config.front_matter("# Body\n");
test.assert_equal(no_header.body, "# Body\n", "body without front matter");
test.assert_equal(html.escape("<a & b>"), "&lt;a &amp; b&gt;", "HTML escaping");
test.assert_contains(html.attr("\"quoted\""), "&quot;quoted&quot;", "attribute escaping");
let items: List<Str> = jsonlite.array_items("[{\"module\":\"a\"}, {\"module\":\"b\"}]");
test.assert_equal(len(items), 2, "array item scanning");
let document: Any = jsonlite.document("{\"name\":\"Ada\",\"values\":[1,2]}");
test.assert_equal(document.name, "Ada", "incremental object parsing");
test.assert_equal(document.values[1], 2, "incremental array parsing");
test.assert_equal(jsonlite.string_field("{\"module\":\"algo.may\",\"name\":\"x\"}", "module"), "algo.may", "string field");
test.test_summary();
